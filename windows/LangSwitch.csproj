<Project Sdk="Microsoft.NET.Sdk">
  <!-- LangSwitch для Windows: один exe на .NET Framework 4.8 (уже встроен в Windows 10/11). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LangSwitch</AssemblyName>
    <RootNamespace>LangSwitch</RootNamespace>
    <ApplicationIcon>res\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(Version)' == ''">2.1.0</Version>
    <Product>LangSwitch</Product>
    <Description>Бесплатный переключатель раскладки</Description>
    <Copyright>MIT</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="res\words-ru.txt.gz" LogicalName="words-ru.txt.gz" />
    <EmbeddedResource Include="res\words-en.txt.gz" LogicalName="words-en.txt.gz" />
    <EmbeddedResource Include="res\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Только для сборки: справочные сборки .NET Framework 4.8 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
